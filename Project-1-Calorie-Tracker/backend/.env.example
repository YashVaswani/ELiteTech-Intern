# Copy to .env and adjust for your environment.

# SQLite by default for zero-setup local dev; swap for Postgres in production, e.g.:
# postgresql+psycopg2://calorie_user:calorie_pass@localhost:5432/calorie_tracker
DATABASE_URL=sqlite:///./calorie_tracker.db

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

CORS_ORIGINS=["http://localhost:5173"]

# Pretrained, open-source (Apache-2.0) Food-101 image classifier from Hugging Face.
ML_MODEL_ID=nateraw/food
ML_TOP_K=3
MAX_UPLOAD_MB=8
DEFAULT_SERVING_GRAMS=150.0
